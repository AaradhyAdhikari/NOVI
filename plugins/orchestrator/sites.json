{
  "chatgpt": {
    "name": "ChatGPT",
    "url": "https://chatgpt.com/",
    "input": "#prompt-textarea, div[contenteditable=\"true\"][id*=\"prompt\"], div[contenteditable=\"true\"][role=\"textbox\"][aria-label*=\"ChatGPT\"], div[contenteditable=\"true\"][data-composer-markdown]",
    "send": "button[data-testid=\"send-button\"], button[aria-label=\"Send prompt\"], #composer-submit-button, button[aria-label*=\"Send\"]",
    "busy": "button[data-testid=\"stop-button\"], button[aria-label*=\"Stop\"]",
    "answer": "[data-message-author-role=\"assistant\"], [data-markdown-text-style=\"assistant-message\"]",
    "login": "button[data-testid=\"login-button\"], a[href*=\"auth/login\"]"
  },
  "gemini": {
    "name": "Gemini",
    "url": "https://gemini.google.com/app",
    "input": "rich-textarea .ql-editor, div[contenteditable=\"true\"][role=\"textbox\"]",
    "send": "button.send-button, button[aria-label*=\"Send message\"]",
    "busy": "button[aria-label*=\"Stop response\"], button.stop",
    "answer": "model-response",
    "login": "a[href*=\"accounts.google.com/ServiceLogin\"], a[aria-label=\"Sign in\"]"
  },
  "perplexity": {
    "name": "Perplexity",
    "url": "https://www.perplexity.ai/",
    "input": "textarea[placeholder*=\"Ask\"], div[contenteditable=\"true\"][role=\"textbox\"], #ask-input",
    "send": "button[aria-label*=\"Submit\"], button[aria-label*=\"Send\"]",
    "busy": "button[aria-label*=\"Stop\"]",
    "answer": "[id^=\"markdown-content\"], .prose",
    "login": "a[href*=\"/login\"], button[data-testid*=\"login\"]"
  },
  "deepseek": {
    "name": "DeepSeek",
    "url": "https://chat.deepseek.com/",
    "input": "textarea#chat-input, textarea",
    "send": "div[role=\"button\"][aria-disabled=\"false\"]:has(svg), button[type=\"submit\"]",
    "busy": "div[class*=\"stop\"], button[aria-label*=\"Stop\"]",
    "answer": ".ds-markdown, [class*=\"markdown\"]",
    "login": "div[class*=\"login\"] input[type=\"password\"], a[href*=\"sign_in\"]"
  }
}

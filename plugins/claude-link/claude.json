{
  "name": "Claude",
  "list": "https://claude.ai/projects",
  "create": "https://claude.ai/projects/create",
  "cards": "a[href*=\"/project/\"]",
  "chats": "a[href*=\"/chat/\"]",
  "page": "main, [data-testid=\"project-page\"]",
  "nameInput": "input#project-name, input[name=\"name\"], input[placeholder*=\"name\" i]",
  "descriptionInput": "textarea#project-description, textarea[name=\"description\"], textarea[placeholder*=\"describ\" i]",
  "submit": "button[type=\"submit\"]",
  "instructionsButton": "button[aria-label*=\"instructions\" i]",
  "instructionsTextButton": "button, [role=\"button\"]",
  "instructionsTexts": ["Set project instructions", "Add instructions", "Edit instructions"],
  "instructionsBox": "div[role=\"dialog\"] textarea",
  "emptyInstructionsBox": "div[role=\"dialog\"] textarea:placeholder-shown",
  "saveButton": "div[role=\"dialog\"] button",
  "saveTexts": ["Save instructions", "Save"],
  "cancelTexts": ["Cancel"],
  "login": "a[href*=\"/login\"], button[data-testid=\"login-with-google\"], input[type=\"email\"]"
}

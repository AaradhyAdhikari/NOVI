# Copy to .env and fill in. Comma-separate multiple keys you legitimately own.
GROQ_API_KEYS=
GEMINI_API_KEYS=
# Extra free brains, used when Groq/Gemini are busy (just a key is enough; *_MODELS overrides the models).
# None of them gets personal turns (email, memory): those stay on Groq.
# Cerebras (cloud.cerebras.ai):
# CEREBRAS_API_KEYS=
# Mistral free "Experiment" plan (console.mistral.ai, phone number, no card; may train on requests):
# MISTRAL_API_KEYS=
# GitHub Models (github.com/settings/tokens → fine-grained token with "Models: read"):
# GITHUBMODELS_API_KEYS=
# CEREBRAS_MODELS= / MISTRAL_MODELS= / GITHUBMODELS_MODELS= / OPENROUTER_MODELS=
# Last backup brain, free models only (openrouter.ai/settings/keys; never used for private turns):
# OPENROUTER_API_KEYS=
# Web search and page reading (plugins/web): Tavily first (app.tavily.com, 1,000 searches a month),
# Jina as backup (jina.ai; pages are read without a key, the key is used only when that is rate-limited):
# TAVILY_API_KEYS=
# JINA_API_KEYS=
# Coding agent: free = Novi Coder on Groq/Gemini (default). claude = Claude Code (uses your Claude plan; enable later).
# NOVI_CODER=free
# Optional overrides:
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# NOVI_FAST_ORDER=groq,gemini
# NOVI_LONG_ORDER=gemini,groq
# NOVI_PORT=3001
# CLAUDE_PATH=C:\Users\you\.local\bin\claude.exe
# Gmail (Google Cloud "Desktop app" OAuth client; publishing status "In production")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Providers allowed to see email content (default groq)
# NOVI_PRIVATE_PROVIDERS=groq

# Your GitHub username, for "show me my GitHub contributions" (works without connecting GitHub)
# NOVI_PLUGIN_GITHUB_USERNAME=AaradhyAdhikari

# Where "make a new project" creates folders (default: Documents\\Projects)
# NOVI_PROJECTS_DIR=

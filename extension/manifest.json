{
  "manifest_version": 3,
  "name": "Novi",
  "version": "1.14.1",
  "description": "Lets Novi (on this laptop) open, read and fill pages in this Chrome when you ask her by voice.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://www.perplexity.ai/*", "https://gamma.app/*"], "js": ["aiwatch.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Novi", "default_popup": "popup.html" }
}
